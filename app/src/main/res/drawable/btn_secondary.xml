<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/colorControlFillPressed" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="?attr/colorDivider" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="?attr/colorDivider" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="?attr/colorDivider" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/colorControlFill" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="?attr/colorDivider" />
        </shape>
    </item>
</selector>
